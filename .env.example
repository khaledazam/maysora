# ========================================================
# MAYSORA - إعدادات الربط والـ Environment Variables
# ========================================================

# رابط الـ Webhook الخاص بـ Google Apps Script لإرسال العملاء لـ Google Sheets
# استبدل هذا الرابط برابط التطبيق الخاص بك بعد نشره في Google Sheets
VITE_GOOGLE_SHEETS_WEBHOOK_URL=

# رابط الموقع الرسمي (يُستخدم في تحسين ظهور الرابط والـ SEO)
VITE_SITE_URL=https://maysora.sa

# رقم الواتساب الرسمي بصيغة دولية (بدون + أو أصفار)
VITE_WHATSAPP_NUMBER=966500000000

# ========================================================
# بكسلات التتبع والتحليلات التسويقية (اختياري عند إطلاق الحملات)
# ========================================================
# معرف تتبع جوجل آناليتكس 4 (مثال: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# معرف بكسل ميتا فيسبوك وإنستغرام (مثال: 123456789012345)
VITE_META_PIXEL_ID=

# معرف بكسل سناب شات (مثال: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
VITE_SNAPCHAT_PIXEL_ID=
